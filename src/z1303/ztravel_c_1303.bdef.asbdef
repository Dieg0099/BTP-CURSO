define behavior for ZTRAVEL_C_1303 alias Travel
{
  use create;
  use update;
  use delete;

  use action acceptTravel;
  use action rejectTravel;
  use action createTravelByTemplate;

  use association _Booking { create; }
}

define behavior for ZBOOKING_C_1303 alias Booking
{
  use update;
  use delete;

  use association _Travel;
  use association _Bksppl { create; }
}

define behavior for ZSUPPL_C_1303 alias BookingSupplement
{
  use update;
  use delete;

  use association _Travel;
  use association _Booking;
}